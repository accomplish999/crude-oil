# Server only. Never commit a real key.
GEMINI_API_KEY=

# Optional. Gemini model id. Default is gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# Public origin, no trailing slash. Used for canonical URLs.
NEXT_PUBLIC_SITE_URL=https://accompli.sh/crude-oil

# Set to /crude-oil when the app is mounted under that path.
NEXT_PUBLIC_BASE_PATH=
